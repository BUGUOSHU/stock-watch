{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-watch",
  "compatibility_date": "2026-10-28",
  "pages_build_output_dir": ".",
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  }
}
